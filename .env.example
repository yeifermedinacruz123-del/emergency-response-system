# =============================================================================
#  EMERGENCY RESPONSE SYSTEM - Variables de entorno (RAIZ)
# =============================================================================
#  Copia este archivo como .env y ajusta los valores.
#  NUNCA subas el archivo .env real a un repositorio.
# =============================================================================

# ----- PostgreSQL (usado por docker-compose.yml) -----
POSTGRES_DB=ers_db
POSTGRES_USER=ers_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_PORT=5432

# ----- pgAdmin (interfaz web opcional para la base de datos) -----
PGADMIN_EMAIL=admin@ers.local
PGADMIN_PASSWORD=cambia_esta_clave
PGADMIN_PORT=5050

# ----- Puerto del backend cuando se ejecuta con Docker -----
BACKEND_PORT=4000
