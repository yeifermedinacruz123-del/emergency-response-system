{
  "name": "ers-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST y servidor de tiempo real del Emergency Response System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "cert": "node scripts/make-cert.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "db:up": "node scripts/db-local.js start",
    "db:down": "node scripts/db-local.js stop",
    "db:status": "node scripts/db-local.js status",
    "db:sql": "node scripts/db-local.js sql",
    "db:reset": "node scripts/db-local.js reset",
    "db:schema": "node scripts/run-sql.js ../database/schema.sql",
    "db:seed": "node scripts/run-sql.js ../database/seed.sql",
    "test": "node tests/api.test.js && node tests/realtime.test.js",
    "test:api": "node tests/api.test.js",
    "test:realtime": "node tests/realtime.test.js",
    "test:security": "node tests/security.test.js"
  },
  "keywords": [
    "express",
    "postgresql",
    "socket.io",
    "jwt",
    "emergencias"
  ],
  "author": "Yeifer Medina",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^16.14.0-beta.17",
    "nodemon": "^3.1.7",
    "selfsigned": "^5.5.0",
    "socket.io-client": "^4.8.3"
  },
  "nodemonConfig": {
    "ignore": [
      "storage/**",
      "uploads/**",
      "logs/**"
    ]
  }
}
