# =============================================================================
#  EMERGENCY RESPONSE SYSTEM - Backend
# =============================================================================
#  1. Copia este archivo:  copy .env.example .env      (Windows)
#                          cp   .env.example .env      (Linux / Mac)
#  2. Cambia TODOS los valores marcados como CAMBIAR.
#  3. El archivo .env NUNCA debe subirse a un repositorio.
# =============================================================================

# ----------------------------- SERVIDOR --------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
# Origen publico de la aplicacion, para los enlaces de recuperacion de
# contrasena. En desarrollo dejalo comentado: se usa la direccion por la que
# entro la peticion (localhost o la IP de la red, util desde el telefono).
# En produccion es obligatorio y debe ser HTTPS. En Render no hace falta:
# se toma solo de RENDER_EXTERNAL_URL, que define la propia plataforma.
# PUBLIC_URL=https://tu-dominio.example

# HTTPS local (para probar el GPS y la PWA desde el telefono).
# El navegador solo permite GPS, camara y service worker en HTTPS o localhost.
# Genera el certificado con:  npm run cert
# En produccion viene apagado por defecto: el HTTPS lo pone el proveedor.
HTTPS_ENABLED=true
HTTPS_PORT=4443

# Cuantos proxies inversos hay DELANTE de la aplicacion.
# 0 = ninguno (desarrollo). Ponlo en 1 al desplegar detras de Nginx, Render, etc.
# ATENCION: si lo pones en 1 sin que exista un proxy real, cualquiera puede
# falsear su IP con la cabecera X-Forwarded-For y saltarse el limitador.
TRUST_PROXY=0

# ----------------------------- BASE DE DATOS ---------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ers_db
DB_USER=ers_user
DB_PASSWORD=CAMBIAR_por_tu_clave
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ----------------------------- POSTGRESQL LOCAL ------------------------------
# Donde se guarda el cluster que crea 'npm run db:up'.
# Por defecto: %LOCALAPPDATA%\ers-postgres\data
# Se deja FUERA de la carpeta del proyecto a proposito: el proyecto esta en
# OneDrive, y OneDrive sincronizando los archivos mientras PostgreSQL los
# escribe puede corromper la base de datos.
# PGDATA_DIR=

# ----------------------------- SEGURIDAD / JWT -------------------------------
# Genera claves largas y aleatorias, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CAMBIAR_por_otra_clave_larga_y_distinta
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ----------------------------- CORS ------------------------------------------
# Origenes permitidos separados por coma. En produccion deja solo tu dominio.
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000,http://localhost:5500,http://127.0.0.1:5500

# ----------------------------- RATE LIMITING ---------------------------------
# Ventana de 15 minutos. El limite general cuenta POR USUARIO (por IP si no
# hay sesion): una red compartida no agota el cupo de todos. El SOS no cuenta.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Intentos FALLIDOS de acceso por cuenta y por IP (el tope por IP es 4 veces este).
AUTH_RATE_LIMIT_MAX=5

# ----------------------------- ARCHIVOS / FOTOS ------------------------------
# Donde se guardan fotos y notas de voz:
#   database  en PostgreSQL (por defecto). Sobrevive a los reinicios de un
#             alojamiento gratuito (en Render el disco se borra) y entra en
#             las copias de seguridad de la base.
#   local     en disco, en UPLOAD_DIR.
# En los dos casos los archivos solo se entregan con un enlace firmado que
# caduca (/uploads ya no es una carpeta publica).
STORAGE_PROVIDER=database
UPLOAD_DIR=uploads/emergencies
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_EMERGENCY=5
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
# Nota de voz del reporte (una por emergencia, comparte el limite de tamano de arriba)
ALLOWED_AUDIO_MIME_TYPES=audio/webm,audio/ogg,audio/mp4,audio/mpeg,audio/aac

# ------------------------ HOJA DE ACCESOS (DEMOSTRACION) ---------------------
# Genera un Excel con los usuarios y sus contrasenas EN TEXTO PLANO, pensado
# para la sustentacion academica. Se actualiza solo cada vez que se crea un
# usuario. En cualquier despliegue real esto debe ir en false.
CREDENTIALS_SHEET_ENABLED=true
CREDENTIALS_DIR=storage/credenciales
CREDENTIALS_FILE=usuarios-y-contrasenas.xlsx
# Contrasena comun de los usuarios que carga database/seed.sql
SEED_PASSWORD=Emergencia2026*

# ----------------------------- FRONTEND --------------------------------------
# Ruta relativa desde backend/src hacia la carpeta del frontend que se sirve.
SERVE_FRONTEND=true
FRONTEND_DIR=../../frontend

# ----------------------------- GEOGRAFIA -------------------------------------
DEFAULT_CITY=Villavicencio
DEFAULT_DEPARTMENT=Meta
DEFAULT_LAT=4.1420
DEFAULT_LNG=-73.6266
DEFAULT_MAP_ZOOM=13

# ----------------------------- LOGS ------------------------------------------
LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_DIR=logs

# ----------------------------- CORREO -----------------------------------------
# Recuperacion de contrasena y aviso a los contactos de confianza en un SOS.
# Sin proveedor, en desarrollo el correo se escribe en la consola del servidor
# (con el enlace), y en produccion no se envia.
#
#   MAIL_PROVIDER=smtp    servidor SMTP (Gmail con contrasena de aplicacion...)
#   MAIL_PROVIDER=brevo   API HTTP de Brevo  (plan gratis: 300 correos/dia)
#   MAIL_PROVIDER=resend  API HTTP de Resend
#
# En Render usa brevo o resend: el plan gratis bloquea el puerto SMTP y el
# correo se quedaba colgado sin llegar. La cuenta del proveedor la crea el
# dueno del proyecto; aqui solo va su clave. MAIL_FROM debe ser un remitente
# verificado en ese proveedor.
# MAIL_PROVIDER=brevo
# MAIL_API_KEY=
# MAIL_FROM=Emergency Response System <tu-correo-verificado@ejemplo.com>
#
# Solo para MAIL_PROVIDER=smtp:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ----------------------------- WEB PUSH (VAPID) ------------------------------
# Genera TUS PROPIAS claves con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# No son credenciales de un servicio externo: identifican a tu servidor ante el
# navegador. La privada nunca debe salir del backend ni subirse a un repositorio.
PUSH_ENABLED=false
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
