# =============================================================================
#  EMERGENCY RESPONSE SYSTEM - Backend
# =============================================================================
#  1. Copia este archivo:  copy .env.example .env      (Windows)
#                          cp   .env.example .env      (Linux / Mac)
#  2. Cambia TODOS los valores marcados como CAMBIAR.
#  3. El archivo .env NUNCA debe subirse a un repositorio.
# =============================================================================

# ----------------------------- SERVIDOR --------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api

# HTTPS local (para probar el GPS y la PWA desde el telefono).
# El navegador solo permite GPS, camara y service worker en HTTPS o localhost.
# Genera el certificado con:  npm run cert
HTTPS_ENABLED=true
HTTPS_PORT=4443

# Cuantos proxies inversos hay DELANTE de la aplicacion.
# 0 = ninguno (desarrollo). Ponlo en 1 al desplegar detras de Nginx, Render, etc.
# ATENCION: si lo pones en 1 sin que exista un proxy real, cualquiera puede
# falsear su IP con la cabecera X-Forwarded-For y saltarse el limitador.
TRUST_PROXY=0

# ----------------------------- BASE DE DATOS ---------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ers_db
DB_USER=ers_user
DB_PASSWORD=CAMBIAR_por_tu_clave
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ----------------------------- POSTGRESQL LOCAL ------------------------------
# Donde se guarda el cluster que crea 'npm run db:up'.
# Por defecto: %LOCALAPPDATA%ers-postgresdata
# Se deja FUERA de la carpeta del proyecto a proposito: el proyecto esta en
# OneDrive, y OneDrive sincronizando los archivos mientras PostgreSQL los
# escribe puede corromper la base de datos.
# PGDATA_DIR=

# ----------------------------- SEGURIDAD / JWT -------------------------------
# Genera claves largas y aleatorias, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CAMBIAR_por_otra_clave_larga_y_distinta
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ----------------------------- CORS ------------------------------------------
# Origenes permitidos separados por coma. En produccion deja solo tu dominio.
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000,http://localhost:5500,http://127.0.0.1:5500

# ----------------------------- RATE LIMITING ---------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=5

# ----------------------------- ARCHIVOS / FOTOS ------------------------------
# Proveedor de almacenamiento: local | s3 | cloudinary  (por ahora solo "local")
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads/emergencies
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_EMERGENCY=5
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
# Nota de voz del reporte (una por emergencia, comparte el limite de tamano de arriba)
ALLOWED_AUDIO_MIME_TYPES=audio/webm,audio/ogg,audio/mp4,audio/mpeg,audio/aac

# ------------------------ HOJA DE ACCESOS (DEMOSTRACION) ---------------------
# Genera un Excel con los usuarios y sus contrasenas EN TEXTO PLANO, pensado
# para la sustentacion academica. Se actualiza solo cada vez que se crea un
# usuario. En cualquier despliegue real esto debe ir en false.
CREDENTIALS_SHEET_ENABLED=true
CREDENTIALS_DIR=storage/credenciales
CREDENTIALS_FILE=usuarios-y-contrasenas.xlsx
# Contrasena comun de los usuarios que carga database/seed.sql
SEED_PASSWORD=Emergencia2026*

# ----------------------------- FRONTEND --------------------------------------
# Ruta relativa desde backend/src hacia la carpeta del frontend que se sirve.
SERVE_FRONTEND=true
FRONTEND_DIR=../../frontend

# ----------------------------- GEOGRAFIA -------------------------------------
DEFAULT_CITY=Villavicencio
DEFAULT_DEPARTMENT=Meta
DEFAULT_LAT=4.1420
DEFAULT_LNG=-73.6266
DEFAULT_MAP_ZOOM=13

# ----------------------------- LOGS ------------------------------------------
LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_DIR=logs

# ----------------------------- NOTIFICACIONES PUSH (FASE 13) -----------------
# Deja estos valores vacios hasta tener un proyecto real de Firebase.
# NO inventes credenciales: se obtienen en https://console.firebase.google.com
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ----------------------------- WEB PUSH (VAPID) ------------------------------
# Genera TUS PROPIAS claves con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# No son credenciales de un servicio externo: identifican a tu servidor ante el
# navegador. La privada nunca debe salir del backend ni subirse a un repositorio.
PUSH_ENABLED=false
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
